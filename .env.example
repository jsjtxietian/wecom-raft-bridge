# 复制为 .env 后填写。环境变量优先；凭据必填，不再读取 txt 文件。
WECOM_BOT_ID=
WECOM_SECRET=
RAFT_SERVER_URL=
RAFT_AGENT_CREDENTIAL=

# 私聊/群聊独立开关；访问范围由企业微信白名单控制，无需群 ID。
WECOM_ALLOW_PRIVATE=true
WECOM_ALLOW_GROUP=true
# 机器人在企微群中的准确显示名，用于清理消息开头的 @名称。
WECOM_BOT_NAME=
RAFT_CHANNEL="#StoryLoom_Wecom"
RAFT_TARGET_AGENT=@Sol
RAFT_EXPECTED_AGENT=@WeCom
RAFT_POLL_MS=2000
