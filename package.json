{
  "name": "wecom-raft-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/bridge.mjs run",
    "start:bg": "node scripts/bridge.mjs start",
    "stop": "node scripts/bridge.mjs stop",
    "status": "node scripts/bridge.mjs status",
    "discover": "tsx src/main.ts discover",
