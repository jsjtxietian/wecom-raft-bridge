    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "ws": "8.21.0"
  }
}
